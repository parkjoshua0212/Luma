# Postgres connection string (Neon in production, local Postgres in dev)
DATABASE_URL=
# Set to "false" for a local/CI Postgres without SSL; any other value (or unset) enables SSL
DB_SSL=
# Secret used to sign and verify JWTs
JWT_SECRET=
# Google Gemini API key
GEMINI_API_KEY=
# Comma-separated browser origins allowed by CORS (default: http://localhost:5173,http://localhost:3000)
ALLOWED_ORIGINS=
# Max login/register attempts per IP per 15 minutes (default: 10)
AUTH_RATE_LIMIT_MAX=
# Port the server listens on (default: 3000)
PORT=
